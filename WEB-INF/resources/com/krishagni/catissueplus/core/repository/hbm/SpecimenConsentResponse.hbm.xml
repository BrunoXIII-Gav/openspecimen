<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping auto-import="false">
  <class name="com.krishagni.catissueplus.core.biospecimen.domain.SpecimenConsentResponse" table="OS_SPECIMEN_CONSENT_RESPONSES">
    <id name="id" column="IDENTIFIER" type="long"><generator class="native"><param name="sequence">OS_SPECIMEN_CONSENT_RESPONSES_SEQ</param></generator></id>
    <many-to-one name="consent" column="CONSENT_ID"/>
    <many-to-one name="consentTier" column="CONSENT_TIER_ID"/>
    <property name="statementCode" column="STATEMENT_CODE"/>
    <property name="statement" column="STATEMENT"/>
    <property name="response" column="RESPONSE"/>
  </class>
</hibernate-mapping>
