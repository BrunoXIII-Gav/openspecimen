<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

  <changeSet author="codex" id="Specimen consent setting">
    <addColumn tableName="CATISSUE_COLLECTION_PROTOCOL">
      <column name="SPECIMEN_CONSENTS_ENABLED" type="${boolean.type}" defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
    </addColumn>
  </changeSet>

  <changeSet author="codex" id="Specimen consents">
    <createTable tableName="OS_SPECIMEN_CONSENTS">
      <column name="IDENTIFIER" type="${int.type}" autoIncrement="${autoIncrement}">
        <constraints nullable="false" primaryKey="true" />
      </column>
      <column name="SPECIMEN_ID" type="${int.type}">
        <constraints nullable="false" foreignKeyName="FK_SPMN_CONSENT_SPMN" referencedTableName="CATISSUE_SPECIMEN" referencedColumnNames="IDENTIFIER" />
      </column>
      <column name="COLL_PROT_REG_ID" type="${int.type}">
        <constraints nullable="false" foreignKeyName="FK_SPMN_CONSENT_CPR" referencedTableName="CATISSUE_COLL_PROT_REG" referencedColumnNames="IDENTIFIER" />
      </column>
      <column name="CONSENT_TYPE" type="${text.type}(255)" />
      <column name="CONSENT_VERSION" type="${text.type}(255)" />
      <column name="SIGN_DATE" type="${nullable.ts.type}" />
      <column name="WITNESS_ID" type="${int.type}">
        <constraints foreignKeyName="FK_SPMN_CONSENT_WITNESS" referencedTableName="CATISSUE_USER" referencedColumnNames="IDENTIFIER" />
      </column>
      <column name="COMMENTS" type="${text.type}(4000)" />
      <column name="STATUS" type="${text.type}(32)"><constraints nullable="false" /></column>
      <column name="CREATOR_ID" type="${int.type}">
        <constraints foreignKeyName="FK_SPMN_CONSENT_CREATOR" referencedTableName="CATISSUE_USER" referencedColumnNames="IDENTIFIER" />
      </column>
      <column name="CREATION_TIME" type="${nullable.ts.type}" />
      <column name="UPDATER_ID" type="${int.type}">
        <constraints foreignKeyName="FK_SPMN_CONSENT_UPDATER" referencedTableName="CATISSUE_USER" referencedColumnNames="IDENTIFIER" />
      </column>
      <column name="UPDATE_TIME" type="${nullable.ts.type}" />
    </createTable>
  </changeSet>

  <changeSet author="codex" id="Specimen consent responses">
    <createTable tableName="OS_SPECIMEN_CONSENT_RESPONSES">
      <column name="IDENTIFIER" type="${int.type}" autoIncrement="${autoIncrement}"><constraints nullable="false" primaryKey="true" /></column>
      <column name="CONSENT_ID" type="${int.type}"><constraints nullable="false" foreignKeyName="FK_SPMN_CONSENT_RESP_CONSENT" referencedTableName="OS_SPECIMEN_CONSENTS" referencedColumnNames="IDENTIFIER" /></column>
      <column name="CONSENT_TIER_ID" type="${int.type}">
        <constraints foreignKeyName="FK_SPMN_CONSENT_RESP_TIER" referencedTableName="CATISSUE_CONSENT_TIER" referencedColumnNames="IDENTIFIER" />
      </column>
      <column name="STATEMENT_CODE" type="${text.type}(255)" />
      <column name="STATEMENT" type="${text.type}(4000)"><constraints nullable="false" /></column>
      <column name="RESPONSE" type="${text.type}(255)" />
    </createTable>
  </changeSet>

  <changeSet author="codex" id="Specimen consent ID generators" dbms="oracle">
    <createSequence sequenceName="OS_SPECIMEN_CONSENTS_SEQ" startValue="1" incrementBy="1" ordered="true" />
    <createSequence sequenceName="OS_SPECIMEN_CONSENT_RESPONSES_SEQ" startValue="1" incrementBy="1" ordered="true" />
    <createSequence sequenceName="OS_SPECIMEN_CONSENT_DOCUMENTS_SEQ" startValue="1" incrementBy="1" ordered="true" />
  </changeSet>

  <changeSet author="codex" id="Specimen consent documents">
    <createTable tableName="OS_SPECIMEN_CONSENT_DOCUMENTS">
      <column name="IDENTIFIER" type="${int.type}" autoIncrement="${autoIncrement}"><constraints nullable="false" primaryKey="true" /></column>
      <column name="CONSENT_ID" type="${int.type}"><constraints nullable="false" foreignKeyName="FK_SPMN_CONSENT_DOC_CONSENT" referencedTableName="OS_SPECIMEN_CONSENTS" referencedColumnNames="IDENTIFIER" /></column>
      <column name="FILE_NAME" type="${text.type}(1024)"><constraints nullable="false" unique="true" uniqueConstraintName="OS_SPMN_CONSENT_DOC_UQ" /></column>
      <column name="ORIGINAL_FILE_NAME" type="${text.type}(1024)"><constraints nullable="false" /></column>
      <column name="CONTENT_TYPE" type="${text.type}(255)" />
      <column name="CREATOR_ID" type="${int.type}">
        <constraints foreignKeyName="FK_SPMN_CONSENT_DOC_CREATOR" referencedTableName="CATISSUE_USER" referencedColumnNames="IDENTIFIER" />
      </column>
      <column name="CREATION_TIME" type="${nullable.ts.type}" />
    </createTable>
  </changeSet>

  <changeSet author="codex" id="Specimen consent indexes">
    <createIndex tableName="OS_SPECIMEN_CONSENTS" indexName="OS_SPMN_CONSENTS_SPMN_IDX"><column name="SPECIMEN_ID" /></createIndex>
    <createIndex tableName="OS_SPECIMEN_CONSENTS" indexName="OS_SPMN_CONSENTS_CPR_IDX"><column name="COLL_PROT_REG_ID" /></createIndex>
  </changeSet>

  <changeSet author="vpawar" id="OAuth states">
    <createTable tableName="OS_OAUTH_STATES">
      <column name="IDENTIFIER" type="${int.type}" autoIncrement="${autoIncrement}">
        <constraints nullable="false" primaryKey="true" />
      </column>
      <column name="STATE" type="${text.type}(255)">
        <constraints nullable="false" unique="true" uniqueConstraintName="OS_OAUTH_STATES_UQ"/>
      </column>
      <column name="DOMAIN_ID" type="${int.type}">
        <constraints nullable="false" foreignKeyName="FK_OAUTH_STATE_DOMAIN"
          referencedTableName="OS_AUTH_DOMAINS" referencedColumnNames="IDENTIFIER" />
      </column>
      <column name="VERIFIER" type="${text.type}(255)">
        <constraints nullable="false" />
      </column>
      <column name="CHALLENGE" type="${text.type}(255)">
        <constraints nullable="false" />
      </column>
      <column name="AUTH_TIME" type="${nullable.ts.type}">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet author="vpawar" id="OAuth state ID generator" dbms="oracle">
    <createSequence sequenceName="OS_OAUTH_STATES_SEQ" startValue="1" incrementBy="1" ordered="true" />
  </changeSet>

  <changeSet author="vpawar" id="Index on OAuth state time to facilitate faster clean up of old states">
    <createIndex tableName="OS_OAUTH_STATES" indexName="OS_OAUTH_STATE_TIME_IDX">
      <column name="AUTH_TIME" />
    </createIndex>
  </changeSet>

  <changeSet author="vpawar" id="CP Request managers">
    <addColumn tableName="CATISSUE_COLLECTION_PROTOCOL">
      <column name="REQ_MANAGERS_USER_GROUP_ID" type="${int.type}">
        <constraints foreignKeyName="FK_CP_REQ_MANAGERS_UG_IDX" referencedTableName="OS_USER_GROUPS"
          referencedColumnNames="IDENTIFIER" />
      </column>
    </addColumn>
  </changeSet>

  <changeSet author="vpawar" id="CP group ID in CP table">
    <addColumn tableName="CATISSUE_COLLECTION_PROTOCOL">
      <column name="CP_GROUP_ID" type="${int.type}">
        <constraints foreignKeyName="FK_CP_CP_GROUP_ID" referencedTableName="OS_CP_GROUPS"
          referencedColumnNames="IDENTIFIER" />
      </column>
    </addColumn>
  </changeSet>

  <changeSet author="vpawar" id="Index on CP group ID of CP table" dbms="oracle">
    <createIndex tableName="CATISSUE_COLLECTION_PROTOCOL" indexName="CP_CP_GROUP_ID_IDX">
      <column name="CP_GROUP_ID" />
    </createIndex>
  </changeSet>

  <changeSet author="vpawar" id="Migrate CP groups to CP table">
    <preConditions onFail="HALT">
      <sqlCheck expectedResult="0">
        <![CDATA[
          select count(*) from (select cp_id from os_cp_group_cps group by cp_id having count(*) > 1) t
        ]]>
      </sqlCheck>
    </preConditions>
    <sql>
      update
        catissue_collection_protocol cp
      set
        cp_group_id = (
          select
            g.group_id
          from
            os_cp_group_cps g
          where
            g.cp_id = cp.identifier
        )
      where
        exists (select 1 from os_cp_group_cps g where g.cp_id = cp.identifier)
    </sql>
  </changeSet>

  <changeSet author="vpawar" id="Drop CP group join table">
    <dropTable tableName="OS_CP_GROUP_CPS" cascadeConstraints="true" />
  </changeSet>

  <changeSet author="vpawar" id="Unique constraint on the container position" dbms="mysql">
    <addUniqueConstraint constraintName="OS_CONTAINER_POS_UQ"
      tableName="OS_CONTAINER_POSITIONS" columnNames="STORAGE_CONTAINER_ID,POS_ONE_STR,POS_TWO_STR"/>
  </changeSet>

  <changeSet author="vpawar" id="Unique constraint on the container position" dbms="oracle">
    <sql>
      create unique index
        OS_CONTAINER_POS_UQ
      on os_container_positions(
        case when
          pos_one_str is not null and pos_two_str is not null
        then
          storage_container_id || '-' || pos_one_str || '-' || pos_two_str
        end
      );
    </sql>
  </changeSet>
</databaseChangeLog>
